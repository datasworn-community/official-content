              {
                "name": "Shawn Tomkin"
              },
              {
                "name": "DiceGoblin"
              }
            ],
            "date": "2026-02-07",
            "license": "https://creativecommons.org/licenses/by/4.0",
            "title": "Ironsworn Discord Giveaway Assets",
            "url": "https://ironswornrpg.com"
          },
          "abilities": [
            {
              "_id": "asset.ability:giveaways_classic/giveaways/bearer.0",
              "controls": {},
              "enabled": true,
              "enhance_moves": [
                {
                  "enhances": null,
                  "roll_type": "action_roll",
                  "trigger": {
                    "conditions": [
                      {
                        "method": null,
                        "roll_options": null,
                        "text": "When you make a move wielding or aided by this object"
                      }
                    ]
                  }
                }
              ],
              "moves": {},
              "options": {},
              "oracles": {},
              "text": "You carry a relic of eldritch power. Envision its form and nature. When you make a move wielding or aided by this object, use a D8 relic die as your action die. If you roll a 1 on that die, the powers backfire; in addition to the outcome of the move, [Endure Harm](datasworn:move:classic/suffer/endure_harm) (-3) or [Endure Stress](datasworn:move:classic/suffer/endure_stress) (-3). If you are separated from the relic, this asset counts as an impact."
            },
            {
              "_id": "asset.ability:giveaways_classic/giveaways/bearer.1",
              "controls": {},
              "enabled": false,
              "moves": {},
              "options": {},
              "oracles": {},
              "text": "When you roll a 7 or 8 on your relic die, you are one with the eldritch powers of the relic. Take an automatic strong hit and +1 momentum."
            },
            {
              "_id": "asset.ability:giveaways_classic/giveaways/bearer.2",
              "controls": {},
              "enabled": false,
              "moves": {},
              "options": {},
              "oracles": {},
              "text": "When you successfully [Fulfill Your Vow](datasworn:move:classic/quest/fulfill_your_vow) in a quest (extreme or epic) to free yourself of the relic, activate this ability at no cost, make a final roll of the relic die, and discard this asset. On 3–8, you embody lingering powers of the relic; improve a stat by +1. On 1–2, improve a stat by +1, but the relic leaves a mark; reduce your max health or spirit to 4."
            }
          ],
          "category": "Path",
          "controls": {},
          "count_as_impact": false,
          "name": "Bearer",
          "options": {
            "name": {
              "field_type": "text",
              "label": "relic",
              "value": null
            }
          },
          "shared": false,
          "type": "asset"
        },
